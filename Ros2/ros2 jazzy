#install ros2 jazzy

sudo apt install software-properties-common
sudo add-apt-repository universe
sudo apt update && sudo apt install curl -y
sudo curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg
sudo sh -c 'echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" > /etc/apt/sources.list.d/ros2.list'
sudo apt update
sudo apt install ros-jazzy-desktop

#Source it automatically (add to ~/.bashrc):
echo "source /opt/ros/jazzy/setup.bash" >> ~/.bashrc
source ~/.bashrc

###Install the packages you actually need for this project:

# Navigation stack — Nav2, planners, controllers
sudo apt install ros-jazzy-navigation2 ros-jazzy-nav2-bringup

# SLAM — builds the map while the robot explores
sudo apt install ros-jazzy-slam-toolbox

# RPLIDAR A2 driver
sudo apt install ros-jazzy-rplidar-ros

# Robot description/transforms + simulation (Gazebo) for testing before you touch hardware
sudo apt install ros-jazzy-robot-state-publisher ros-jazzy-xacro
sudo apt install ros-jazzy-ros-gz

# Camera driver (for Camera Module 3 via v4l2 or libcamera-based node)
sudo apt install ros-jazzy-v4l2-camera ros-jazzy-image-transport ros-jazzy-cv-bridge

# Build tools you'll want for custom nodes
sudo apt install ros-dev-tools
